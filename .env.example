LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
LLM_MODEL=deepseek/deepseek-v4-flash-0731
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_REQUIRE_PARAMETERS=true
STRUCTURED_OUTPUT_METHOD=json_schema
# Опциональный ключ для других OpenAI-совместимых API:
# LLM_API_KEY=local

EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIMENSION=4096
EMBEDDING_BATCH_SIZE=32
# EMBEDDING_API_KEY=local

# Нативные Ollama адаптеры, выбираются независимо для чата и эмбеддингов.
# Для полностью локального использования: LLM_PROVIDER=ollama, EMBEDDING_PROVIDER=ollama,
# EMBEDDING_DIMENSION=768 (для nomic-embed-text).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=faq
DATABASE_USER=faq
DATABASE_PASSWORD=change-me
DATABASE_CONNECT_TIMEOUT=10
API_PORT=8000

TRAIN_DATA_PATH=data_raw/train_our.jsonl
CHUNK_CHARS=1800
CHUNK_OVERLAP=200
SEARCH_TOP_K=6
MAX_TOOL_CALLS=3
MAX_EVIDENCE_CHUNKS=8
HISTORY_TURNS=6
HISTORY_CHARS=12000
MAX_INPUT_CHARS=4000
REQUEST_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO

# Langfuse
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
